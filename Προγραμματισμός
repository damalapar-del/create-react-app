/* src/App.css */
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
    sans-serif;
  background: #f3f4f6;
}

.app {
  min-height: 100vh;
}

.app-header {
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: white;
  padding: 24px 16px;
  text-align: center;
}

.app-header h1 {
  margin: 0 0 8px;
  font-size: 1.8rem;
}

.app-header p {
  margin: 0;
  opacity: 0.9;
}

.app-main {
  max-width: 960px;
  margin: 24px auto 40px;
  padding: 0 16px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.card {
  background: white;
  border-radius: 12px;
  padding: 16px 18px 18px;
  box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06);
}

.card h2 {
  margin-top: 0;
  margin-bottom: 8px;
  font-size: 1.2rem;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 12px;
}

.field label {
  font-size: 0.85rem;
  color: #4b5563;
}

input,
select,
button {
  font-family: inherit;
}

input[type="text"],
input[type="date"],
input[type="time"],
input[type="number"],
select {
  padding: 6px 8px;
  border-radius: 8px;
  border: 1px solid #d1d5db;
  font-size: 0.95rem;
}

input:focus,
select:focus {
  outline: none;
  border-color: #4f46e5;
  box-shadow: 0 0 0 1px rgba(79, 70, 229, 0.25);
}

button {
  border-radius: 999px;
  cursor: pointer;
  border: none;
  padding: 8px 16px;
  font-size: 0.95rem;
}

button.primary-button {
  background: #4f46e5;
  color: white;
  font-weight: 500;
}

button.primary-button:hover {
  background: #4338ca;
}

button:not(.primary-button) {
  background: #e5e7eb;
  color: #111827;
}

button:not(.primary-button):hover {
  background: #d1d5db;
}

.link-button {
  background: transparent;
  color: #4f46e5;
  padding: 0;
  margin-left: 8px;
}

.link-button:hover {
  text-decoration: underline;
}

.grid {
  display: grid;
  gap: 12px;
}

.two-cols {
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
}

.three-cols {
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
}

.workhours-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 8px;
  margin-top: 8px;
}

.workhours-row {
  display: flex;
  align-items: center;
  gap: 6px;
}

.day-label {
  width: 80px;
  font-size: 0.9rem;
  color: #374151;
}

.list {
  list-style: none;
  padding-left: 0;
  margin: 12px 0 0;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 0;
  border-bottom: 1px solid #e5e7eb;
  font-size: 0.9rem;
}

.list-item:last-child {
  border-bottom: none;
}

.hint {
  font-size: 0.8rem;
  color: #6b7280;
  margin-top: 8px;
}

.day-block {
  margin-top: 12px;
  padding-top: 8px;
  border-top: 1px solid #e5e7eb;
}

.day-block h3 {
  margin: 0 0 4px;
  font-size: 1rem;
}

.unscheduled {
  margin-top: 16px;
  padding-top: 10px;
  border-top: 1px dashed #f97316;
}

.unscheduled h3 {
  color: #b45309;
}
